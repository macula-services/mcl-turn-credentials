%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_turn_credentials.
%%
%% Mints short-lived TURN credentials over the mesh, keeping the master secret out of client apps
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %% 1.4 is wire 1.0: it carries macula 16.0, the wire the live fleet
    %% speaks since 19 Oct. A 0.x floor addresses macula 12.x, and the two do
    %% not complete a handshake with each other.
    {mcl_om, "~> 1.4"},
    %% Declared directly: this service calls macula modules of its own (and
    %% compiles against its behaviours), rather than reaching the mesh only
    %% through mcl_om. Naming the major is what stops a rebuild from taking the
    %% next one silently (macula-codebase-checks#14).
    {macula, "~> 16.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula reaches this app only through mcl_om, so rebar3 leaves it out of the
%% PLT and dialyzer cannot check the macula_response callbacks the mint handler
%% implements. Name it, so the behaviour is checked rather than excused.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om]}
]}.

{relx, [
    {release, {mcl_turn_credentials, "0.1.0"}, [mcl_turn_credentials, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
