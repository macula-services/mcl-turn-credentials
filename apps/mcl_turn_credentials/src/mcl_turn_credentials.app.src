{application, mcl_turn_credentials, [
    {description, "Mints short-lived TURN credentials over the mesh, keeping the master secret out of client apps"},
    {vsn, "0.1.0"},
    {registered, [mcl_turn_credentials_sup]},
    {mod, {mcl_turn_credentials_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-turn-credentials"}]}
]}.
